<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fundo creme -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/creme" />
        </shape>
    </item>

    <!-- Forma verde no canto superior direito -->
    <item
        android:gravity="top|right"
        android:top="-90dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <size
                android:width="260dp"
                android:height="260dp" />
            <solid android:color="@color/verde_floresta" />
        </shape>
    </item>

    <!-- Forma verde-clara no canto inferior esquerdo -->
    <item
        android:gravity="bottom|left"
        android:bottom="-100dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <size
                android:width="230dp"
                android:height="230dp" />
            <solid android:color="@color/verde_claro" />
        </shape>
    </item>

</layer-list>